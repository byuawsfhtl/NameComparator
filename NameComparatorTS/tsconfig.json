{
    "compilerOptions": {
      "target": "ES2020",
      "module": "nodenext",
      "moduleResolution": "nodenext",
      "lib": ["ES2020"],
      "outDir": "./dist",
      "rootDir": "../",
      "strict": true,
      "esModuleInterop": true,
      "skipLibCheck": true,
      "forceConsistentCasingInFileNames": true,
      "declaration": true,
      "declarationMap": true,
      "sourceMap": true,
      "resolveJsonModule": true,
      "types": ["node"],
      "typeRoots": ["./node_modules/@types", "./src/types", "../node_modules/@types"]
    },
    "include": ["src", "bridge_for_tests.ts", "nameComparator.ts", "../data/**/*"],
    "exclude": ["node_modules", "dist"]
  }
  