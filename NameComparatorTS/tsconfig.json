{
    "compilerOptions": {
      "target": "ESNext",
      "module": "ESNext",
      "declaration": true,
      "declarationMap": true,
      "sourceMap": true,
      "rootDir": ".",
      "outDir": "dist",
      "moduleResolution": "node",
      "esModuleInterop": true,
      "resolveJsonModule": true,
      "forceConsistentCasingInFileNames": true,
      "strict": true,
      "skipLibCheck": true,
      "typeRoots": ["./node_modules/@types", "./src/types", "../node_modules/@types"]
    },
    "include": ["src", "bridge_for_tests.ts", "nameComparator.ts", "data"],
    "exclude": ["node_modules", "dist"]
  }
  